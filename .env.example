# ───── الخادم ─────
PORT=3200
HOST=0.0.0.0
# HTTPS محلي للجوالات على نفس الشبكة (التطوير فقط). off للتعطيل
HTTPS_PORT=3443
# شهادة حقيقية بدل الشهادة الذاتية (مثلاً من mkcert)
# HTTPS_KEY=./certs/key.pem
# HTTPS_CERT=./certs/cert.pem
# خلف وسيط (Render/Nginx/Cloudflare): اقرأ IP اللاعب من X-Forwarded-For
# TRUST_PROXY=1

# ───── الاتصال الصوتي WebRTC ─────
# STUN عام افتراضيًا. لشبكات الجوال/الشركات المقيدة أضف خادم TURN:
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# إما بيانات ثابتة:
# TURN_USERNAME=user
# TURN_CREDENTIAL=pass
# أو سر coturn (use-auth-secret) لإصدار بيانات مؤقتة لكل لاعب:
# TURN_SECRET=change-me
# TURN_TTL=21600

# ───── البيانات ─────
# البلاغات: ملف محلي افتراضيًا، أو PostgreSQL (يتطلب npm i pg)
REPORTS_FILE=data/reports.jsonl
# DATABASE_URL=postgres://user:pass@host:5432/gallidha

# ───── للاختبارات الآلية فقط (لا تستخدمها في الإنتاج) ─────
# GAME_SPEED=0.4
# FORCE_SOUND=animals/cow
